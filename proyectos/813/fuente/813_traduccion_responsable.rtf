\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\qj\li940\ri1002\lin940\rin1002\fi431\sb2\sa0{\rtlch \ltrch
\'97}{\rtlch \ltrch\loch
\'bfQue si \'e9l ha mentido? \'97exclam\'f3 Lupin, comprendiendo en ella la humillaci\'f3n femenina\'97. \'bfQue si \'e9l ha mentido? \'a1\'c9l, gran duque! No es m\'e1s que un polichinela cuyos hilos manejaba yo, un instrumento al que yo manejaba para representar escenas creadas por mi fantas\'eda. \'a1Ah, ese imb\'e9cil, ese imb\'e9cil!}
\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\qj\li940\ri1007\lin940\rin1007\fi431\sb4\sa0{\rtlch \ltrch\loch
