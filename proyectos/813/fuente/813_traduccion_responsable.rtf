\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\li1371\ri0\lin1371\rin0\fi0\sl240\slmult1\sb4\sa0{\rtlch \ltrch
