\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\qj\li940\ri1012\lin940\rin1012\fi431\sb3\sa0{\rtlch \ltrch
