\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\li940\ri918\lin940\rin918\fi431\sb4\sa0{\rtlch \ltrch
