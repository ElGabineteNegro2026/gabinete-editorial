\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\qj\li940\ri1002\lin940\rin1002\fi431{\rtlch \ltrch\loch
Salt\'f3 hacia atr\'e1s, estremecido de terror y con los ojos desorbitados. \'bfQu\'e9? \'bfQu\'e9 ocurr\'eda? \'bfQu\'e9 era aquella innoble impresi\'f3n de fr\'edo que le produc\'edan las manos?}
\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\li1371\ri0\lin1371\rin0\fi0\sl240\slmult1\sb2\sa0{\rtlch \ltrch
\'97}{\rtlch \ltrch\loch
\'a1Octavio! \'a1Octavio! \'97grit\'f3, sin recordar la ausencia del ch\'f3fer.}
\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\qj\li940\ri1003\lin940\rin1003\fi431{\rtlch \ltrch\loch
\'a1Auxilio! Necesitaba auxilio. Precisaba que alguien le tranquilizara y ayudara. Temblaba de miedo. \'a1Oh!, aquel fr\'edo, aquel fr\'edo de la muerte que \'e9l hab\'eda sentido.}
\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\li940\ri918\lin940\rin918\fi0\sb2\sa0{\rtlch \ltrch\loch
