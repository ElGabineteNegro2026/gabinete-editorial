\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\li940\ri918\lin940\rin918\fi431\sb0\sa0{\rtlch \ltrch\loch
Una hora m\'e1s tarde, el se\'f1or Lenormand recib\'eda una llamada telef\'f3nica: Valenglay, presidente del Consejo, requer\'eda su presencia en el Ministerio del Interior.}
\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\li940\ri918\lin940\rin918\fi431\sb2\sa0{\rtlch \ltrch
\'97}{\rtlch \ltrch\loch
\'a1Qu\'e9 buena cara tiene usted, mi querido Lenormand! \'a1Y yo que lo cre\'eda a usted enfermo y no me atrev\'eda a molestarlo!}
\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\li1371\ri0\lin1371\rin0\fi0\sl240\slmult1\sb2\sa0{\rtlch \ltrch
\'97}{\rtlch \ltrch\loch
Yo no estoy enfermo, se\'f1or presidente.}
\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\li1371\ri0\lin1371\rin0\fi0\sl240\slmult1{\rtlch \ltrch
\'97}{\rtlch \ltrch\loch
Entonces esa ausencia era motivada por el enojo\'85 Siempre con ese mal genio.}
