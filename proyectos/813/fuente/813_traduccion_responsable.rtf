\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\qj\li940\ri998\lin940\rin998\fi431{\rtlch \ltrch
\'97}{\rtlch \ltrch\loch
Ya est\'e1. Luis de Malreich\'85, las iniciales L. M\'85, la espantosa y aterradora firma\'85 El asesino se llama Luis de Malreich\'85, era el hermano de Altenheim y el hermano de Isilda. Mat\'f3 a uno y a otra por temor a sus revelaciones\'85}
\par \pard\plain \s26\li1371\ri0\lin1371\rin0\fi0\sb41\sa0\hich\af3\dbch\af3\afs29\loch\f3\fs29\sl266\slmult1\qj\li940\ri1010\lin940\rin1010\fi431\sb3\sa0{\rtlch \ltrch\loch
